{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CIConfig",
  "type": "object",
  "properties": {
    "target_company": { "type": "string" },
    "market": { "type": "string" },
    "primary_geography": { "type": "string" },
    "min_confidence_for_action": { "type": "string", "enum": ["high", "medium", "low"] },
    "disconfirmation_required": { "type": "boolean" },
    "monitored_competitors": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["target_company", "market"]
}
