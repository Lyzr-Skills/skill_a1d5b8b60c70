{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Signal",
  "type": "object",
  "properties": {
    "signal_id": { "type": "string" },
    "competitor_id": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "category": { "type": "string", "enum": ["pricing", "product", "positioning", "campaign", "sentiment", "hiring", "other"] },
    "observed_at": { "type": "string", "format": "date" },
    "evidence_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "impact_level": { "type": "string", "enum": ["high", "medium", "low", "none"] }
  },
  "required": ["signal_id", "competitor_id", "title", "category", "observed_at", "evidence_ids"]
}
